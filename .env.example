# Preferred ports are in %APPDATA%/the_study_platform/settings.json:
# Missing fields use port_mapping.json (currently frontend 5100 / backend 8011).
# If either is busy, run.py finds the next free one.
# Override per launch: run_lan.bat --frontend-port 8080 --backend-port 8000
# Command-line flags override saved settings. PORT/BACKEND_PORT/FRONTEND_PORT
# environment values do not override ports when using run.py.
BACKEND_HOST=0.0.0.0
# One SQLite file shared by projects, stories, problems, and submissions.
# Blank: <settings data_dir>/jira.db; default %TEMP%/the_study_platform/jira.db.
# Data folder is configured in Settings or %APPDATA%/the_study_platform/settings.json.
DATABASE_PATH=

# Optional override for editor drafts and narration (blank: <data_dir>/workspace/<database-id>).
WORKSPACE_STORAGE_DIR=

# LLM and speech requests go through The Connector. Configure provider
# credentials and Kokoro voice/language/device settings in The Connector.
LLM_PROVIDER=the_connector
CONNECTOR_BASE_URL=http://127.0.0.1:8301/v1
CONNECTOR_SPEECH_TIMEOUT_SECONDS=180
# An active model_id from GET /v1/models. Blank selects the first discovered ID.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
# For explicit offline demo/test fixtures only: LLM_PROVIDER=mock

# Execution and Upload Limits
MAX_UPLOAD_MB=256
# Opt in to importing sample problems into a newly created database.
AUTO_SEED=0
# Opt in to importing data from legacy database locations on startup.
MIGRATE_LEGACY_DATABASES=0
