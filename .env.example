# Preferred ports. If either is busy, run.py advances until it finds a free one.
BACKEND_PORT=3001
FRONTEND_PORT=5173
BACKEND_HOST=127.0.0.1
DATABASE_PATH=

# Disk-backed editor drafts and cached Kokoro MP3s (blank: data/workspace/<database-id>)
WORKSPACE_STORAGE_DIR=

# Separate Python 3.12 Kokoro service (python-kokoro/server.py)
# Root setup/run scripts prepare/start it; use cpu on machines without CUDA.
KOKORO_DEVICE=cuda
KOKORO_BASE_URL=http://127.0.0.1:8880
KOKORO_MODEL=kokoro
KOKORO_LANGUAGE=auto
KOKORO_VOICE=
KOKORO_SPEED=1.0
KOKORO_TIMEOUT_SECONDS=180

# LLM requests go through The Connector's active configuration library.
# Configure upstream provider credentials in The Connector, not this app.
LLM_PROVIDER=the_connector
CONNECTOR_BASE_URL=http://127.0.0.1:8301/v1
# An active model_id from GET /v1/models. Blank selects the first discovered ID.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
# For explicit offline demo/test fixtures only: LLM_PROVIDER=mock

# Execution and Upload Limits
MAX_UPLOAD_MB=256
AUTO_SEED=1
