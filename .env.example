# Preferred frontend/backend ports. If either is busy, run.py finds the next free one.
# Override per launch: run_lan.bat --frontend-port 8080 --backend-port 8000
# Command-line flags win; legacy PORT overrides BACKEND_PORT when no flag is set.
BACKEND_PORT=3001
FRONTEND_PORT=5173
BACKEND_HOST=127.0.0.1
# One SQLite file shared by projects, stories, problems, and submissions.
# Blank: backend/data/jira.db
DATABASE_PATH=

# Disk-backed editor drafts and cached narration MP3s (blank: data/workspace/<database-id>)
WORKSPACE_STORAGE_DIR=

# LLM and speech requests go through The Connector. Configure provider
# credentials and Kokoro voice/language/device settings in The Connector.
LLM_PROVIDER=the_connector
CONNECTOR_BASE_URL=http://127.0.0.1:8301/v1
CONNECTOR_SPEECH_TIMEOUT_SECONDS=180
# An active model_id from GET /v1/models. Blank selects the first discovered ID.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
# For explicit offline demo/test fixtures only: LLM_PROVIDER=mock

# Execution and Upload Limits
MAX_UPLOAD_MB=256
AUTO_SEED=1
